# Kariyer Ajanı — Frontend Environment Variables
# Bu dosyayı kopyalayıp frontend/.env olarak kaydet (gitignored).

# Backend API adresi (opsiyonel, varsayılan http://127.0.0.1:8000)
# VITE_API_URL=http://127.0.0.1:8000

# Google Sign-In ("Google ile Bağlan" düğmesi için).
# backend'deki GOOGLE_CLIENT_ID ile AYNI değer olmalı.
# Google Cloud Console > APIs & Services > Credentials'tan alınır.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
