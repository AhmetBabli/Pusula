# Kariyer Ajanı — Environment Variables
# 🔴 NEVER commit real API keys to this file. Use .env (gitignored)

# ===== CRİTİKAL: Ortam Değişkenleri =====
# Development
DEBUG=true

# AI Service (Google Gemini)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Güvenlik (Production'da zorunlu) =====
# Generate strong keys with:
# - SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# - ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-this-in-production
ENCRYPTION_KEY=your_fernet_key_here

# ===== Database =====
# Development: SQLite (default)
DATABASE_URL=sqlite:///./kariyer_ajani.db

# Production: PostgreSQL (uncomment and configure)
# DATABASE_URL=postgresql://user:password@localhost:5432/kariyer_ajani

# ===== Şifremi Unuttum: Sistem E-postası =====
# Uygulamanın KENDİ adına gönderdiği e-postalar (şifre sıfırlama linki) için —
# kullanıcıların kendi bağladığı Gmail hesaplarından (Ayarlar > Gelen Kutusu)
# ayrı, uygulamanın kendi Gmail hesabı. Gmail hesap ayarlarından bir
# "uygulama şifresi" (app password) oluşturman gerekir.
# Boş bırakılırsa /auth/forgot-password gerçek e-posta göndermez (loglara
# hata düşer) ama kullanıcıya yine de genel bir "gönderildi" mesajı döner.
SYSTEM_EMAIL_ADDRESS=your_system_email@gmail.com
SYSTEM_EMAIL_APP_PASSWORD=your_app_password

# Şifre sıfırlama e-postasındaki bağlantının işaret edeceği frontend adresi.
FRONTEND_BASE_URL=http://localhost:5173

# ===== Optional: Google Sign-In (Üye Ol ekranındaki "Google ile Bağlan") =====
# Google Cloud Console'da OAuth Client ID oluştur (Web application tipi):
# https://console.cloud.google.com/apis/credentials
# - Authorized JavaScript origins: http://localhost:5173
# - Authorized redirect URIs gerekmez (popup/auth-code akışı "postmessage" kullanır)
# Ayrıca OAuth consent screen'de "https://www.googleapis.com/auth/gmail.send" scope'unu ekle.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
